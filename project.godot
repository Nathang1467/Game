; Engine configuration file.
config_version=5

[application]

config/name="TILT"
config/description="A pinball roguelite. Build a cursed table, beat the arcade."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DB="*res://scripts/autoload/db.gd"
Run="*res://scripts/autoload/run.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/default_font_multichannel_signed_distance_field=false

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.06, 0.05, 0.1, 1)
